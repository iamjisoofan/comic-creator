{
  "title": "Hello, Dog Man",
  "tone": "funny",
  "chapters": [
    {
      "number": 1,
      "title": "Hello, Dog Man",
      "pages": [
        {
          "number": 1,
          "layout": "2x2",
          "panels": [
            {
              "id": "ch1-p1-01",
              "shot": "wide",
              "description": "Dog Man outside on a sunny morning, happy.",
              "cast": [
                "dog-man"
              ],
              "caption": "ONE MORNING...",
              "dialogue": [
                {
                  "speaker": "dog-man",
                  "text": "TIME FOR MY BIG BONE!"
                }
              ]
            },
            {
              "id": "ch1-p1-02",
              "shot": "wide",
              "description": "Dog Man stares at the empty bowl. The bone is gone.",
              "cast": [
                "dog-man"
              ],
              "sfx": "GASP!",
              "dialogue": [
                {
                  "speaker": "dog-man",
                  "text": "MY BONE! IT IS GONE!"
                }
              ]
            },
            {
              "id": "ch1-p1-03",
              "shot": "wide",
              "description": "Dog Man finds muddy paw prints on the ground.",
              "cast": [
                "dog-man"
              ],
              "dialogue": [
                {
                  "speaker": "dog-man",
                  "text": "PAW PRINTS! WHO TOOK IT?"
                }
              ]
            },
            {
              "id": "ch1-p1-04",
              "shot": "wide",
              "description": "Dog Man dashes off, speed lines behind him.",
              "cast": [
                "dog-man"
              ],
              "sfx": "WHOOSH!",
              "dialogue": [
                {
                  "speaker": "dog-man",
                  "text": "I AM ON IT!"
                }
              ]
            }
          ]
        },
